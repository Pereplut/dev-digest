# engineering-insights hook state (condensed transcripts, per-session markers)
.claude/.insights-state/

# pr-self-review state (plan, findings, verdict, report) — per-clone, per-diff
.claude/.pr-self-review/

# /impl state (saved Development Plans, round ledgers) — per-clone, per-run
.claude/.sdd/

# Per-session agent usage rows captured for /retro; the composed retrospective
# lives in WORKFLOW-RETRO.md and IS tracked.
.claude/.retro/

# emdash worktree config (local)
.emdash.json

# Compose overrides are per-machine (a host port already taken, a different
# volume path). Compose merges this file automatically when present, so
# committing one would force every clone onto one developer's local setup.
docker-compose.override.yml
