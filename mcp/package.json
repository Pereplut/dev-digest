{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server — five tools (list_review_agents, review_pull_request, get_findings, get_repo_conventions, get_blast_radius stub) over the DevDigest API. stdio primary, Streamable HTTP optional. No DB/GitHub access of its own — a thin HTTP client over the API.",
  "scripts": {
    "dev": "tsx src/entry/stdio.ts",
    "dev:http": "tsx src/entry/http.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "arch": "depcruise src --output-type err-long",
    "lint": "eslint . && npm run arch"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "fastify": "^5.2.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "js-tiktoken": "^1.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
